#!/usr/bin/env bash

# Initialize database tables before migrations
echo "Checking database tables..."
python /usr/src/arx/init_db.py

# Run migrations before starting (with retry)
echo "Running migrations..."
for i in 1 2 3 4 5; do
    if evennia migrate --noinput; then
        echo "Migrations completed successfully"
        break
    else
        echo "Migration attempt $i failed, retrying in 10 seconds..."
        sleep 10
    fi
done

# Start the server
echo "Starting server..."
evennia start &

#Needed to keep container running
tail -f /dev/null
