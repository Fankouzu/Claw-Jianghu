#!/usr/bin/env bash

# Set environment variables
export DJANGO_SETTINGS_MODULE=server.conf.railway_ws_settings
export PYTHONPATH=/usr/src/arx:$PYTHONPATH

# Railway routes traffic to targetPort 4002, so proxy must listen there
export PORT="4002"

echo "=== WebSocket Service Starting ==="
echo "Proxy will listen on port: $PORT"
echo "DJANGO_SETTINGS_MODULE: $DJANGO_SETTINGS_MODULE"
echo "Current time: $(date)"
echo "Git commit: $(git rev-parse HEAD 2>/dev/null || echo 'not a git repo')"

# Evennia internal ports - WebSocket on 8001 (proxy forwards from 4002)
export WEBSOCKET_CLIENT_PORT="8001"
export WEBSOCKET_CLIENT_INTERFACE="127.0.0.1"
export WEBSERVER_PORT_EXTERNAL="4001"
export WEBSERVER_PORT_INTERNAL="5001"
echo "Evennia WebSocket will be on internal port 8001"

# Other settings
export TELNET_INTERFACES="0.0.0.0"
export ALLOWED_HOSTS=".railway.app,localhost,127.0.0.1,claw-jianghu-ws.up.railway.app,.mudclaw.net"
export WEBSOCKET_CLIENT_URL="wss://claw-jianghu-ws.up.railway.app"

# Clean up stale pidfiles
rm -f /usr/src/arx/server/portal.pid /usr/src/arx/server/server.pid

# Wait for database
echo "Waiting for database..."
sleep 3

# Initialize database tables before migrations
echo "Checking database tables..."
python /usr/src/arx/init_db.py 2>/dev/null || true

# Run migrations
echo "Running migrations..."
for i in 1 2 3; do
    if evennia migrate --noinput 2>&1; then
        echo "Migrations completed"
        break
    else
        echo "Migration attempt $i failed, retrying..."
        sleep 5
    fi
done

# Reset admin command sets to fix any corrupted data
echo "=== Resetting Admin Command Sets ==="
python /usr/src/arx/scripts/reset_admin_cmdsets.py 2>&1 || echo "Command set reset failed!"

# Test command set import before starting Evennia
echo "=== Testing command set import ==="
python -c "
import os
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'server.conf.railway_ws_settings')
import django
django.setup()

# Initialize Evennia
import evennia
evennia._init()

print('Testing command set imports...')
from commands.default_cmdsets import CharacterCmdSet, AccountCmdSet
cs = CharacterCmdSet()
cs.at_cmdset_creation()
print(f'Commands in CharacterCmdSet: {len(list(cs.commands))}')
acc = AccountCmdSet()
acc.at_cmdset_creation()
print(f'Commands in AccountCmdSet: {len(list(acc.commands))}')
print('Command set import successful!')
" 2>&1 || echo "Command set import test failed!"

# Check if there's any issue with the cmdset path
echo "=== Checking CMDSET settings ==="
python -c "
import os
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'server.conf.railway_ws_settings')
from django.conf import settings
print(f'CMDSET_CHARACTER: {settings.CMDSET_CHARACTER}')
print(f'CMDSET_ACCOUNT: {settings.CMDSET_ACCOUNT}')
" 2>&1

# Test connect command
echo "=== Testing Connect Command ==="
python /usr/src/arx/scripts/test_connect.py 2>&1 || echo "Connect test failed!"

# Start Evennia in foreground mode to see all output
echo "Starting Evennia server in foreground mode..."
evennia start --log-to-console &
EVENNIA_PID=$!

# Wait for Evennia to start and capture initial output
echo "Waiting for Evennia to initialize..."
sleep 30

# Check if Evennia is running
if kill -0 $EVENNIA_PID 2>/dev/null; then
    echo "Evennia is running (PID: $EVENNIA_PID)"

    # Check for server logs
    if [ -f "/usr/src/arx/server/logs/server.log" ]; then
        echo "=== Server Log (last 100 lines) ==="
        tail -100 /usr/src/arx/server/logs/server.log 2>/dev/null || echo "Could not read server log"
    fi

    if [ -f "/usr/src/arx/server/logs/portal.log" ]; then
        echo "=== Portal Log (last 50 lines) ==="
        tail -50 /usr/src/arx/server/logs/portal.log 2>/dev/null || echo "Could not read portal log"
    fi
else
    echo "WARNING: Evennia may not have started correctly"

    # Try to show any crash logs
    if [ -f "/usr/src/arx/server/logs/server.log" ]; then
        echo "=== Server Log ==="
        cat /usr/src/arx/server/logs/server.log 2>/dev/null || true
    fi
fi

# Start the unified proxy (this keeps the container running)
echo "=== Starting HTTP+WebSocket Proxy ==="
exec python /usr/src/arx/bin/ws_proxy.py