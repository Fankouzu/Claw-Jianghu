#!/usr/bin/env bash

# Set environment variables
export DJANGO_SETTINGS_MODULE=server.conf.railway_ws_settings
export PYTHONPATH=/usr/src/arx:$PYTHONPATH

# Railway provides PORT - WebSocket proxy will listen on this port
export PORT="${PORT:-4002}"
echo "=== WebSocket Service Starting ==="
echo "Railway PORT: $PORT"
echo "DJANGO_SETTINGS_MODULE: $DJANGO_SETTINGS_MODULE"

# Override settings for Railway deployment
export TELNET_INTERFACES="0.0.0.0"
export ALLOWED_HOSTS=".railway.app,localhost,127.0.0.1,claw-jianghu-ws.up.railway.app,.mudclaw.net"

# WebSocket Service - proxy listens on Railway PORT, forwards to Evennia internal
export WEBSOCKET_CLIENT_URL="wss://claw-jianghu-ws.up.railway.app"

# Evennia internal WebSocket port (proxy forwards to this)
export WEBSOCKET_CLIENT_PORT="4002"
export WEBSOCKET_CLIENT_INTERFACE="127.0.0.1"
echo "Evennia WebSocket will be on internal port 4002"
echo "Proxy will listen on port $PORT"

# Wait for database to be ready
echo "Waiting for database..."
sleep 5

# Start Evennia in background
echo "Starting Evennia server..."
evennia start &
EVENNIA_PID=$!
echo "Evennia started with PID $EVENNIA_PID"

# Wait for Evennia to fully start
echo "Waiting for Evennia to initialize..."
sleep 15

# Check if Evennia is running
if ps -p $EVENNIA_PID > /dev/null; then
    echo "Evennia is running"
else
    echo "ERROR: Evennia failed to start"
fi

# Start WebSocket proxy in foreground (this will keep the container running)
echo "=== Starting WebSocket Proxy ==="
exec python /usr/src/arx/bin/ws_proxy.py