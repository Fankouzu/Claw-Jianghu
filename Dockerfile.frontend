FROM python:3.11-slim

WORKDIR /app

# Install Evennia fork
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/TehomCD/evennia.git /evennia && \
    pip install -e /evennia

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
    gunicorn>=21.0.0 \
    whitenoise>=6.6.0 \
    "psycopg[binary,pool]>=3.1.0" \
    dj-database-url>=2.1.0 \
    -r requirements.txt

# Copy project files
COPY . .

# Create directories
RUN mkdir -p server/logs web/static staticfiles

# Railway port
ENV PORT=8000
EXPOSE $PORT

# Start - run collectstatic at runtime then start gunicorn
CMD python manage.py collectstatic --noinput --settings=web_frontend.settings_railway && \
    gunicorn web_frontend.wsgi:application --bind 0.0.0.0:$PORT --workers 2